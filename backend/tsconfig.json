{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useUnknownInCatchVariables": false,
    "declaration": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "dist"],
  "ts-node": {
    "transpileOnly": true
  }
}
